<mxfile host="app.diagrams.net"><diagram name="Overview" id="a-extension"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="A extension: atomics in the load/store unit" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1000" height="36" as="geometry"/></mxCell><mxCell id="group-0" value="&lt;b&gt;AMO sequencer states&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=60;verticalAlign=top;align=center;spacingTop=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="120" width="1200" height="280" as="geometry"/></mxCell><mxCell id="rob" value="&lt;b&gt;ROB head&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;address resolved&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="160" height="120" as="geometry"/></mxCell><mxCell id="stq" value="&lt;b&gt;Store queue&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="240" y="160" width="240" height="160" as="geometry"/></mxCell><mxCell id="stq-row0" value="atomic: op, lr flag" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=9;fillColor=#d5e8d4;strokeColor=#82b366;opacity=70;" vertex="1" parent="1"><mxGeometry x="248" y="190" width="224" height="18" as="geometry"/></mxCell><mxCell id="stq-row1" value="" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=9;fillColor=#d5e8d4;strokeColor=#82b366;opacity=70;" vertex="1" parent="1"><mxGeometry x="248" y="212" width="224" height="18" as="geometry"/></mxCell><mxCell id="stq-row2" value="" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=9;fillColor=#d5e8d4;strokeColor=#82b366;opacity=70;" vertex="1" parent="1"><mxGeometry x="248" y="234" width="224" height="18" as="geometry"/></mxCell><mxCell id="s0" value="IDLE" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="560" y="160" width="120" height="80" as="geometry"/></mxCell><mxCell id="s1" value="READ" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="720" y="160" width="120" height="80" as="geometry"/></mxCell><mxCell id="s2" value="READ_WAIT" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="880" y="160" width="120" height="80" as="geometry"/></mxCell><mxCell id="s3" value="CALC" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1040" y="160" width="120" height="80" as="geometry"/></mxCell><mxCell id="s4" value="WRITE" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1200" y="160" width="120" height="80" as="geometry"/></mxCell><mxCell id="s5" value="WRITE_WAIT" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1360" y="160" width="120" height="80" as="geometry"/></mxCell><mxCell id="s6" value="DONE" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1520" y="160" width="120" height="80" as="geometry"/></mxCell><mxCell id="res" value="&lt;b&gt;Reservation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;valid, word address&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="560" y="480" width="240" height="80" as="geometry"/></mxCell><mxCell id="pay" value="&lt;b&gt;AMO ALU&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;swap, add, xor, and, or,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;min, max (signed, unsigned)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="880" y="480" width="240" height="80" as="geometry"/></mxCell><mxCell id="out" value="&lt;b&gt;Result register&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;old value, then CDB&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1200" y="480" width="240" height="80" as="geometry"/></mxCell><mxCell id="text-0" value="Only word atomics (funct3 = W). aq and rl are carried and ignored." style="text;html=1;verticalAlign=middle;align=left;fontSize=9;" vertex="1" parent="1"><mxGeometry x="40" y="624" width="600" height="24" as="geometry"/></mxCell><mxCell id="text-1" value="The cache sees the read and the write as two ordinary accesses; the sequencer holds the line between them." style="text;html=1;verticalAlign=middle;align=left;fontSize=9;" vertex="1" parent="1"><mxGeometry x="40" y="644.0" width="600" height="24" as="geometry"/></mxCell><mxCell id="page-note" value="Atomics wait at the ROB head, then the sequencer runs a read, an ALU step and a write on the cache port. LR sets a reservation; SC checks it. An atomic entry never forwards to loads." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1"><mxGeometry x="30" y="730" width="1700" height="24" as="geometry"/></mxCell><mxCell id="edge-0" value="token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=9;fontColor=#666666;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.375;entryDx=0;entryDy=0;fillColor=#e1d5e7;strokeColor=#9673a6;" edge="1" parent="1" source="rob" target="stq"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=9;fontColor=#666666;labelBackgroundColor=default;exitX=1.0;exitY=0.25;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#d5e8d4;strokeColor=#82b366;" edge="1" parent="1" source="stq" target="s0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=9;fontColor=#666666;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=9;fontColor=#666666;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=9;fontColor=#666666;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=9;fontColor=#666666;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=9;fontColor=#666666;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=9;fontColor=#666666;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-8" value="LR: no write, set the reservation" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=9;fontColor=#666666;labelBackgroundColor=default;exitX=0.5;exitY=0.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;" edge="1" parent="1" source="s2" target="s6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="940" y="92"/><mxPoint x="1580" y="92"/></Array></mxGeometry></mxCell><mxCell id="edge-9" value="SC hit: write rs2, return 0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=9;fontColor=#666666;labelBackgroundColor=default;exitX=0.1667;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entry