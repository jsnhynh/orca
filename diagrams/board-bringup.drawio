<mxfile host="app.diagrams.net"><diagram name="Overview" id="board-bringup"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="940" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="KV260 bring-up over USB JTAG" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1000" height="36" as="geometry"/></mxCell><mxCell id="group-0" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Host computer&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="640" height="820" as="geometry"/></mxCell><mxCell id="group-1" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;KV260 carrier and K26 module&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="700" y="60" width="1080" height="820" as="geometry"/></mxCell><mxCell id="group-2" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Processing system&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1010" y="100" width="740" height="400" as="geometry"/></mxCell><mxCell id="group-3" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Programmable logic&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1010" y="520" width="740" height="320" as="geometry"/></mxCell><mxCell id="term" value="Terminal&lt;br&gt;console text in, keystrokes out (ctrl-] quits)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="50" y="110" width="580" height="70" as="geometry"/></mxCell><mxCell id="script" value="orca_host.py --jtag&lt;br&gt;loads, launches, relays the console&lt;br&gt;one JTAG session at a time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="50" y="220" width="580" height="80" as="geometry"/></mxCell><mxCell id="xsdb" value="xsdb and kv260_jtag.tcl&lt;br&gt;Vivado xsdb (xsct is disabled in 2026.1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="50" y="340" width="580" height="80" as="geometry"/></mxCell><mxCell id="files" value="Files in the kit (src/prebuilt)&lt;br&gt;orca_kv260.bit  bitstream&lt;br&gt;psu_init.tcl  PS clocks, DDR, isolation, PL reset&lt;br&gt;relay.elf  A53 console relay&lt;br&gt;Image + orca-kv260-143-jtag.dtb  Linux, 115200 baud&lt;br&gt;coremark_kv260.bin  CoreMark image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="50" y="460" width="580" height="150" as="geometry"/></mxCell><mxCell id="usb" value="USB-JTAG&lt;br&gt;carrier X-MLCC-01" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="730" y="110" width="240" height="70" as="geometry"/></mxCell><mxCell id="bootrom" value="1 Boot ROM&lt;br&gt;alternate boot mode JTAG&lt;br&gt;0xFF5E0200 = 0x0100, reset" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1040" y="150" width="220" height="80" as="geometry"/></mxCell><mxCell id="init" value="2 psu_init&lt;br&gt;PLLs, pl_clk0, DDR,&lt;br&gt;isolation removal, PL reset" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1280" y="150" width="220" height="80" as="geometry"/></mxCell><mxCell id="a53" value="4 Cortex-A53 #0&lt;br&gt;runs relay.elf from OCM&lt;br&gt;no OS, MMU off" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1520" y="150" width="210" height="80" as="geometry"/></mxCell><mxCell id="ocm" value="OCM rings&lt;br&gt;header 0xFFFD0000, receive ring 0xFFFE0000&lt;br&gt;transmit ring for keystrokes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1380" y="290" width="350" height="70" as="geometry"/></mxCell><mxCell id="ddr" value="PS DDR&lt;br&gt;0x7000_0000, 256 MiB reserved (no-map)&lt;br&gt;5 Image and dtb written by JTAG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1040" y="400" width="300" height="80" as="geometry"/></mxCell><mxCell id="hp0" value="HP0 port&lt;br&gt;128-bit AXI4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1400" y="400" width="200" height="80" as="geometry"/></mxCell><mxCell id="bit" value="3 Bitstream&lt;br&gt;orca_kv260.bit loaded by xsdb" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1040" y="570" width="220" height="80" as="geometry"/></mxCell><mxCell id="orca" value="ORCA core&lt;br&gt;150 MHz, boot ROM overlay&lt;br&gt;DDR window 0x1000_0000&lt;br&gt;6 released by a host CSR write" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1280" y="570" width="220" height="130" as="geometry"/></mxCell><mxCell id="hostap" value="Host aperture&lt;br&gt;0xA400_0000, 128 KiB&lt;br&gt;SoC CSRs, host console UART" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1520" y="570" width="210" height="90" as="geometry"/></mxCell><mxCell id="uart" value="ORCA UART&lt;br&gt;console TX and RX" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1280" y="740" width="220" height="60" as="geometry"/></mxCell><mxCell id="text-0" value="7 Console path" style="text;html=1;verticalAlign=middle;align=left;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="634" width="600" height="24" as="geometry"/></mxCell><mxCell id="text-1" value="ORCA UART TX goes to the host console UART. The A53 relay" style="text;html=1;verticalAlign=middle;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="659" width="600" height="24" as="geometry"/></mxCell><mxCell id="text-2" value="copies its bytes into the OCM receive ring, xsdb reads the ring" style="text;html=1;verticalAlign=middle;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="679" width="600" height="24" as="geometry"/></mxCell><mxCell id="text-3" value="in bulk, and orca_host.py prints them. Keystrokes travel the" style="text;html=1;verticalAlign=middle;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="699" width="600" height="24" as="geometry"/></mxCell><mxCell id="text-4" value="other way through the transmit ring." style="text;html=1;verticalAlign=middle;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="719" width="600" height="24" as="geometry"/></mxCell><mxCell id="text-5" value="Linux: the dtb address is passed in a1, and the kernel runs" style="text;html=1;verticalAlign=middle;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="759" width="600" height="24" as="geometry"/></mxCell><mxCell id="text-6" value="from the DDR window with a built-in initramfs." style="text;html=1;verticalAlign=middle;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="779" width="600" height="24" as="geometry"/></mxCell><mxCell id="text-7" value="CoreMark: coremark_kv260.bin is linked at 0x1000_0000 and" style="text;html=1;verticalAlign=middle;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="804" width="600" height="24" as="geometry"/></mxCell><mxCell id="text-8" value="returns to the boot stub when it finishes." style="text;html=1;verticalAlign=middle;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="824" width="600" height="24" as="geometry"/></mxCell><mxCell id="page-note" value="Numbers give the order of the steps. No SD card or Arm Linux is involved; xsdb drives the board and the host script relays the console." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1"><mxGeometry x="30" y="910" width="1740" height="24" as="geometry"/></mxCell><mxCell id="edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=0.0;exitDx=0;exitDy=0;entryX=0.5;entryY=1.0;entryDx=0;entryDy=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" edge="1" parent="1" source="script" target="term"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" edge="1" parent="1" source="script" target="xsdb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=0.0;exitDx=0;exitDy=0;entryX=0.5;entryY=1.0;entryDx=0;entryDy=0;fillColor=#f5f5f5;strokeColor=#666666;" edge="1" parent="1" source="files" target="xsdb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-3" value="JTAG" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" edge="1" parent="1" source="xsdb" target="usb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="680" y="380"/><mxPoint x="680" y="145"/></Array></mxGeometry></mxCell><mxCell id="edge-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.7857;exitDx=0;exitDy=0;entryX=0.0;entryY=0.1875;entryDx=0;entryDy=0;fillColor=#f5f5f5;strokeColor=#666666;" edge="1" parent="1" source="usb" target="bootrom"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#ffffff;strokeColor=#666666;" edge="1" parent="1" source="bootrom" target="init"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#ffffff;strokeColor=#666666;" edge="1" parent="1" source="init" target="a53"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.7;entryY=0.0;entryDx=0;entryDy=0;fillColor=#ffffff;strokeColor=#666666;" edge="1" parent="1" source="a53" target="ocm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#f5f5f5;strokeColor=#666666;" edge="1" parent="1" source="usb" target="ddr"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="850" y="200"/><mxPoint x="850" y="440"/></Array></mxGeometry></mxCell><mxCell id="edge-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#f5f5f5;strokeColor=#666666;" edge="1" parent="1" source="usb" target="bit"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="850" y="200"/><mxPoint x="850" y="610"/></Array></mxGeometry></mxCell><mxCell id="edge-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#ffffff;strokeColor=#666666;" edge="1" parent="1" source="ddr" target="hp0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.25;exitY=1.0;exitDx=0;exitDy=0;entryX=0.7727;entryY=0.0;entryDx=0;entryDy=0;fillColor=#ffffff;strokeColor=#666666;" edge="1" parent="1" source="hp0" target="orca"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.3077;entryDx=0;entryDy=0;fillColor=#ffffff;strokeColor=#666666;" edge="1" parent="1" source="bit" target="orca"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fillColor=#ffffff;strokeColor=#666666;" edge="1" parent="1" source="orca" target="uart"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#ffffff;strokeColor=#666666;" edge="1" parent="1" source="uart" target="hostap"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1510" y="770"/><mxPoint x="1510" y="615"/></Array></mxGeometry></mxCell><mxCell id="edge-15" value="relay reads the host UART" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#ffffff;strokeColor=#666666;dashed=1;" edge="1" parent="1" source="hostap" target="a53"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1742" y="615"/><mxPoint x="1742" y="190"/></Array></mxGeometry></mxCell><mxCell id="edge-16" value="reads the rings over JTAG" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.625;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;" edge="1" parent="1" source="xsdb" target="ocm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="680" y="390"/><mxPoint x="680" y="325"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="Sequence" id="board-bringup-sequence"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="940" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Bring-up sequence" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1000" height="36" as="geometry"/></mxCell><mxCell id="n0" value="1  Select JTAG boot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="115" width="190" height="90" as="geometry"/></mxCell><mxCell id="h0" value="Host&lt;br&gt;write 0xFF5E0200 = 0x0100, reset the system" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="250" y="115" width="540" height="90" as="geometry"/></mxCell><mxCell id="b0" value="Board&lt;br&gt;the boot ROM waits instead of starting the QSPI firmware" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="810" y="115" width="950" height="90" as="geometry"/></mxCell><mxCell id="n1" value="2  Run psu_init" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="225" width="190" height="90" as="geometry"/></mxCell><mxCell id="h1" value="Host&lt;br&gt;run psu_init.tcl from the platform export" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="250" y="225" width="540" height="90" as="geometry"/></mxCell><mxCell id="b1" value="Board&lt;br&gt;PLLs and pl_clk0, DDR controller, PS to PL isolation removed, PL reset" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="810" y="225" width="950" height="90" as="geometry"/></mxCell><mxCell id="n2" value="3  Program the logic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="335" width="190" height="90" as="geometry"/></mxCell><mxCell id="h2" value="Host&lt;br&gt;download orca_kv260.bit over JTAG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="250" y="335" width="540" height="90" as="geometry"/></mxCell><mxCell id="b2" value="Board&lt;br&gt;ORCA is configured and held in reset by the SoC CSR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="810" y="335" width="950" height="90" as="geometry"/></mxCell><mxCell id="n3" value="4  Start the relay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="445" width="190" height="90" as="geometry"/></mxCell><mxCell id="h3" value="Host&lt;br&gt;load relay.elf into OCM and run it on Cortex-A53 #0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="250" y="445" width="540" height="90" as="geometry"/></mxCell><mxCell id="b3" value="Board&lt;br&gt;bare metal, MMU off; it copies the host console UART into an OCM ring" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="810" y="445" width="950" height="90" as="geometry"/></mxCell><mxCell id="n4" value="5  Load the image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="555" width="190" height="90" as="geometry"/></mxCell><mxCell id="h4" value="Host&lt;br&gt;write Image and the device tree into PS DDR at 0x7000_0000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="250" y="555" width="540" height="90" as="geometry"/></mxCell><mxCell id="b4" value="Board&lt;br&gt;ORCA sees them at 0x1000_0000 through the DDR line bridge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="810" y="555" width="950" height="90" as="geometry"/></mxCell><mxCell id="n5" value="6  Release ORCA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="665" width="190" height="90" as="geometry"/></mxCell><mxCell id="h5" value="Host&lt;br&gt;write the SoC CSR through the host aperture (offset 0x13000)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="250" y="665" width="540" height="90" as="geometry"/></mxCell><mxCell id="b5" value="Board&lt;br&gt;the boot ROM stub starts the image; Linux gets the device tree address in a1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="810" y="665" width="950" height="90" as="geometry"/></mxCell><mxCell id="n6" value="7  Relay the console" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="775" width="190" height="90" as="geometry"/></mxCell><mxCell id="h6" value="Host&lt;br&gt;read the OCM rings in bulk; write keystrokes into the transmit ring" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="250" y="775" width="540" height="90" as="geometry"/></mxCell><mxCell id="b6" value="Board&lt;br&gt;orca_host.py prints the bytes; ctrl-] ends the session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="810" y="775" width="950" height="90" as="geometry"/></mxCell><mxCell id="text-0" value="Step" style="text;html=1;verticalAlign=middle;align=left;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="84" width="600" height="24" as="geometry"/></mxCell><mxCell id="text-1" value="Host action" style="text;html=1;verticalAlign=middle;align=left;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="84" width="600" height="24" as="geometry"/></mxCell><mxCell id="text-2" value="Board result" style="text;html=1;verticalAlign=middle;align=left;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="84" width="600" height="24" as="geometry"/></mxCell><mxCell id="page-note" value="Each step is one xsdb action driven by orca_host.py. The board needs only power and its USB cable." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1"><mxGeometry x="30" y="910" width="1740" height="24" as="geometry"/></mxCell><mxCell id="edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" edge="1" parent="1" source="h0" target="b0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" edge="1" parent="1" source="h1" target="b1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" edge="1" parent="1" source="h2" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" edge="1" parent="1" source="h3" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" edge="1" parent="1" source="h4" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" edge="1" parent="1" source="h5" target="b5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" edge="1" parent="1" source="h6" target="b6"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Memory map" id="board-bringup-memory-map"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="640" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Addresses used during bring-up" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1000" height="36" as="geometry"/></mxCell><mxCell id="group-0" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Arm (PS) address space&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="860" height="500" as="geometry"/></mxCell><mxCell id="group-1" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;ORCA address space&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="920" y="70" width="860" height="500" as="geometry"/></mxCell><mxCell id="ocm" value="OCM: 0xFFFD_0000 header, 0xFFFE_0000 receive ring&lt;br&gt;console relay state shared with the host over JTAG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="820" height="80" as="geometry"/></mxCell><mxCell id="ddr" value="PS DDR: 0x7000_0000 to 0x7FFF_FFFF (256 MiB, reserved no-map)&lt;br&gt;kernel Image, device tree and CoreMark are written here by JTAG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="820" height="80" as="geometry"/></mxCell><mxCell id="aper" value="Host aperture: 0xA400_0000 (128 KiB)&lt;br&gt;offset 0x00000: DMA buffer; offset 0x10000: ORCA MMIO pages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="820" height="80" as="geometry"/></mxCell><mxCell id="hp0" value="HP0 port, 128-bit AXI4&lt;br&gt;carries ORCA&#x27;s cached DDR window to PS DDR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="820" height="80" as="geometry"/></mxCell><mxCell id="rom" value="0x0000_0000: boot ROM overlay (4 KiB)&lt;br&gt;the boot stub that starts the image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="940" y="110" width="820" height="80" as="geometry"/></mxCell><mxCell id="dma" value="0x0000_8000 to 0x0000_bfff: uncached DMA window&lt;br&gt;host aperture offset 0x00000 maps here" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="940" y="210" width="820" height="80" as="geometry"/></mxCell><mxCell id="win" value="0x1000_0000 to 0x1FFF_FFFF: DDR window&lt;br&gt;maps to PS 0x7000_0000; the kernel runs from here" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="940" y="310" width="820" height="80" as="geometry"/></mxCell><mxCell id="mmio" value="0x8000_0000 to 0x8000_4FFF: MMIO pages&lt;br&gt;host aperture offset 0x10000 maps here; SoC CSR at 0x8000_3000, host console UART at 0x8000_4000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="940" y="410" width="820" height="80" as="geometry"/></mxCell><mxCell id="page-note" value="The same memory is named differently by the Arm side and by ORCA. The host aperture and the DDR window are the two bridges." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1"><mxGeometry x="30" y="610" width="1740" height="24" as="geometry"/></mxCell><mxCell id="edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="aper" target="dma"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="895" y="350"/><mxPoint x="895" y="250"/></Array></mxGeometry></mxCell><mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#d5e8d4;strokeColor=#82b366;" edge="1" parent="1" source="ddr" target="win"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="250"/><mxPoint x="900" y="350"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>