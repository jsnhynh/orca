ometry"/></mxCell><mxCell id="payload" value="Payload array&lt;br&gt;ROB-indexed, immutable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="875" y="310" width="195" height="70" as="geometry"/></mxCell><mxCell id="rob" value="Reorder buffer&lt;br&gt;64 entries, status + result storage, 2-wide retire" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="650" y="410" width="420" height="70" as="geometry"/></mxCell><mxCell id="sched" value="Scheduler&lt;br&gt;12 entries, age matrix, 3 issue ports" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1150" y="120" width="320" height="70" as="geometry"/></mxCell><mxCell id="lsq" value="Load/store queues&lt;br&gt;load 12 (FIFO), store 12 (FIFO)&lt;br&gt;wait table 256, forwarding, atomics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1150" y="210" width="320" height="90" as="geometry"/></mxCell><mxCell id="rr" value="Register read&lt;br&gt;bypass, replay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1150" y="320" width="150" height="70" as="geometry"/></mxCell><mxCell id="prf" value="Physical registers&lt;br&gt;64 x 32, 6 read ports" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1320" y="320" width="150" height="70" as="geometry"/></mxCell><mxCell id="wake" value="Wakeup&lt;br&gt;CDB wake view&lt;br&gt;speculative load wake" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1150" y="410" width="200" height="70" as="geometry"/></mxCell><mxCell id="alu0" value="ALU 0&lt;br&gt;branch resolve" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strok