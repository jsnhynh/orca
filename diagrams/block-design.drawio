nt="1" source="commit" target="fetch"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="12" y="655"/><mxPoint x="12" y="345"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="Front end" id="block-design-frontend"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Front end, cycle by cycle" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1000" height="36" as="geometry"/></mxCell><mxCell id="group-0" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;F1: cycle 0&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="430" height="520" as="geometry"/></mxCell><mxCell id="group-1" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;F2: cycle 1&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="470" y="70" width="430" height="520" as="geometry"/></mxCell><mxCell id="group-2" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;F3: cycle 2&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="920" y="70" width="520" height="520" as="geometry"/></mxCell><mxCell id="group-3" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;D: cycle 3&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1480" y="70" width="300" height="520" as="geometry"/></mxCell><mxCell id="pcsel" value="Request launch (priority order)&lt;br&gt;1 pred_redirect_val: L1 repair&lt;br&gt;2 flush_pending_q: latched redirect&lt;br&gt;3 startup_q: reset PC&lt;br&gt;4 next_req_pending_q: deferred successor&lt;br&gt;5 pc_req_next: fallthrough or L0 target" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="390" height="150" as="geometry"/></mxCell><mxCell id="l0" value="L0 BTB lookup&lt;br&gt;same-cycle target" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="190" height="70" as="geometry"/></mxCell><mxCell id="req" value="I-cache request&lt;br&gt;tag and data RAM address" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="250" y="290" width="180" height="70" as="geometry"/></mxCell><mxCell id="bpureq" value="BTB, TAGE and RAS request&lt;br&gt;same fetch address and history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="390" height="70" as="geometry"/></mxCell><mxCell id="note1" value="Two instructions per request&lt;br&gt;aligned to an 8-byte group; pc[2] set gives one valid lane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="390" height="70" as="geometry"/></mxCell><mxCell id="icread" value="I-cache SRAM read&lt;br&gt;2 ways, 64-bit data banks, tag RAM per way&lt;br&gt;tag compare and way select on the RAM outputs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="490" y="110" width="390" height="100" as="geometry"/></mxCell><mxCell id="bpuread" value="BTB, TAGE and RAS read&lt;br&gt;synchronous reads, one cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="490" y="240" width="390" height="80" as="geometry"/></mxCell><mxCell id="presp" value="pipe_resp register&lt;br&gt;collects the cache response, lane valids&lt;br&gt;and the table outputs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="490" y="350" width="390" height="70" as="geometry"/></mxCell><mxCell id="miss" value="I-cache miss&lt;br&gt;starts a refill of four 128-bit beats&lt;br&gt;the requester replays the request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="490" y="450" width="390" height="100" as="geometry"/></mxCell><mxCell id="accept" value="Response accept&lt;br&gt;hold register empty or released" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="940" y="110" width="230" height="70" as="geometry"/></mxCell><mxCell id="predec" value="Predecode&lt;br&gt;branch, JAL, JALR, call, return" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1190" y="110" width="230" height="70" as="geometry"/></mxCell><mxCell id="verdict" value="L1 verdict&lt;br&gt;agrees with L0: continue&lt;br&gt;differs: hold one cycle, repair" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="940" y="210" width="230" height="90" as="geometry"/></mxCell><mxCell id="scrub" value="Lane scrub&lt;br&gt;removes the younger lane when&lt;br&gt;slot 0 ends the packet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1190" y="210" width="230" height="90" as="geometry"/></mxCell><mxCell id="hold" value="Hold register&lt;br&gt;one packet, one cycle&lt;br&gt;imem_rec_rdy drops while held" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="940" y="330" width="230" height="90" as="geometry"/></mxCell><mxCell id="ibuf" value="Instruction buffer&lt;br&gt;4 entries, FIFO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1190" y="330" width="230" height="90" as="geometry"/></mxCell><mxCell id="ftqa" value="FTQ allocation (BPU alloc control)&lt;br&gt;one FTQ entry per fetch packet with GHR and RAS checkpoints;&lt;br&gt;speculative history and RAS updated from predecode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="940" y="450" width="480" height="100" as="geometry"/></mxCell><mxCell id="dreg" value="Decode register&lt;br&gt;2 decoders&lt;br&gt;legality check, immediates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1500" y="110" width="260" height="100" as="geometry"/></mxCell><mxCell id="dnext" value="Rename (cycle 4)&lt;br&gt;next stage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1500" y="240" width="260" height="80" as="geometry"/></mxCell><mxCell id="page-note" value="Cycle numbers are relative to the I-cache request. File names are under rtl/cpu/ in the design repository." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1"><mxGeometry x="30" y="670" width="1740" height="24" as="geometry"/></mxCell><mxCell id="edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=0.0;exitDx=0;exitDy=0;entryX=0.2436;entryY=1.0;entryDx=0;entryDy=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" edge="1" parent="1" source="l0" target="pcsel"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="135" y="275"/></Array></mxGeometry></mxCell><mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.7692;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="pcsel" target="req"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="340" y="275"/></Array></mxGeometry></mxCell><mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5128;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5128;entryY=0.0;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="pcsel" target="bpureq"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="240" y="372"/></Array></mxGeometry></mxCell><mxCell id="edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#d5e8d4;strokeColor=#82b366;" edge="1" parent="1" source="req" target="icread"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="450" y="325"/><mxPoint x="470" y="325"/><mxPoint x="470" y="160"/></Array></mxGeometry></mxCell><mxCell id="edge-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" edge="1" parent="1" source="bpureq" target="bpuread"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="450" y="425"/><mxPoint x="470" y="425"/><mxPoint x="470" y="280"/></Array></mxGeometry></mxCell><mxCell id="edge-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" edge="1" parent="1" source="bpuread" target="presp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fillColor=#d5e8d4;strokeColor=#82b366;" edge="1" parent="1" source="icread" target="miss"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="presp" target="accept"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="385"/><mxPoint x="920" y="385"/><mxPoint x="920" y="145"/></Array></mxGeometry></mxCell><mxCell id="edge-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="accept" target="predec"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="accept" target="verdict"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="predec" target="scrub"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="verdict" target="hold"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="scrub" target="ibuf"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#ffe6cc;strokeColor=#d79b00;" edge="1" parent="1" source="hold" target="ibuf"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="predec" target="ftqa"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1440" y="145"/><mxPoint x="1440" y="500"/></Array></mxGeometry></mxCell><mxCell id="edge-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#ffe6cc;strokeColor=#d79b00;" edge="1" parent="1" source="ibuf" target="dreg"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1460" y="375"/><mxPoint x="1460" y="160"/></Array></mxGeometry></mxCell><mxCell id="edge-16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="dreg" target="dnext"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Rename and dispatch" id="block-design-rename-dispatch"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="860" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Rename and dispatch" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1000" height="36" as="geometry"/></mxCell><mxCell id="group-0" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Rename (stage 3)&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="760" height="460" as="geometry"/></mxCell><mxCell id="group-1" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Dispatch (stage 4, same cycle as rename)&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="820" y="70" width="960" height="460" as="geometry"/></mxCell><mxCell id="group-2" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Retirement side&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="20" y="570" width="1760" height="240" as="geometry"/></mxCell><mxCell id="dec" value="Decode register&lt;br&gt;2 instructions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="160" height="70" as="geometry"/></mxCell><mxCell id="map" value="Speculative RAT&lt;br&gt;32 x 6-bit, newest mapping" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="230" y="110" width="260" height="70" as="geometry"/></mxCell><mxCell id="com" value="Committed RAT&lt;br&gt;32 x 6-bit, retired state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="520" y="110" width="240" height="70" as="geometry"/></mxCell><mxCell id="free" value="Free list&lt;br&gt;circular FIFO of free physical IDs&lt;br&gt;head, tail, commit head&lt;br&gt;two LUTRAM banks, two pops per group&lt;br&gt;registered credit admits a group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="230" y="210" width="260" height="130" as="geometry"/></mxCell><mxCell id="busy" value="Busy table&lt;br&gt;allocated, not yet completed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="520" y="210" width="240" height="60" as="geometry"/></mxCell><mxCell id="ckpt" value="Checkpoints&lt;br&gt;RAT snapshot per FTQ entry&lt;br&gt;with the free-list head" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="520" y="290" width="240" height="80" as="geometry"/></mxCell><mxCell id="owner" value="Owner storage&lt;br&gt;LUTRAM per ROB entry&lt;br&gt;destination, stale destination, flags" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="230" y="370" width="260" height="70" as="geometry"/></mxCell><mxCell id="rnout" value="Renamed group&lt;br&gt;physical IDs and ROB IDs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="520" y="400" width="240" height="70" as="geometry"/></mxCell><mxCell id="rules" value="Group rules&lt;br&gt;sources read first&lt;br&gt;younger lane sees the&lt;br&gt;older lane&#x27;s mapping&lt;br&gt;p0 reads zero, never&lt;br&gt;allocated&lt;br&gt;reset: x0..x31 map to&lt;br&gt;p0..p31, p32..p63 free" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="170" height="220" as="geometry"/></mxCell><mxCell id="cls" value="Classification&lt;br&gt;every instruction without an exception&lt;br&gt;enters the scheduler;&lt;br&gt;loads and stores also take a queue slot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="840" y="110" width="280" height="110" as="geometry"/></mxCell><mxCell id="rob" value="ROB allocation&lt;br&gt;64 entries, status 3 bits&lt;br&gt;2 per cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1160" y="110" width="280" height="80" as="geometry"/></mxCell><mxCell id="pay" value="Payload array&lt;br&gt;64 x 106-bit, ROB-indexed&lt;br&gt;PC, immediate, controls" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1480" y="110" width="280" height="80" as="geometry"/></mxCell><mxCell id="sched" value="Scheduler&lt;br&gt;16 x 32-bit entries&lt;br&gt;class: ALU, MDU, SYS, MEM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="840" y="260" width="280" height="70" as="geometry"/></mxCell><mxCell id="ldq" value="Load queue&lt;br&gt;12 entries, FIFO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1160" y="260" width="280" height="70" as="geometry"/></mxCell><mxCell id="stq" value="Store queue&lt;br&gt;12 entries, FIFO (stores, atomics)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1480" y="260" width="280" height="70" as="geometry"/></mxCell><mxCell id="exc" value="Exception path&lt;br&gt;an instruction that already carries an exception still gets a ROB entry, in program order,&lt;br&gt;but never occupies an issue slot or an execution unit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="840" y="360" width="920" height="70" as="geometry"/></mxCell><mxCell id="ret" value="Retire ids (registered)&lt;br&gt;commit frees one stale physical ID&lt;br&gt;per committed writer, in program order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="330" height="100" as="geometry"/></mxCell><mxCell id="push" value="Free-list push&lt;br&gt;stale IDs at the tail;&lt;br&gt;available the following cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="420" y="620" width="330" height="100" as="geometry"/></mxCell><mxCell id="rec" value="Recovery and flush&lt;br&gt;recovery restores the checkpointed head&lt;br&gt;full flush restores the commit head&lt;br&gt;no allocation masks or bitmaps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="800" y="620" width="400" height="100" as="geometry"/></mxCell><mxCell id="cmt" value="Committed RAT update&lt;br&gt;retirement changes the map; values stay in the&lt;br&gt;physical register file, nothing is copied" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1250" y="620" width="500" height="100" as="geometry"/></mxCell><mxCell id="page-note" value="A two-instruction group advances only when physical registers, a ROB entry and queue space are all available." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1"><mxGeometry x="30" y="830" width="1740" height="24" as="geometry"/></mxCell><mxCell id="edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="dec" target="map"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="map" target="com"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="505" y="145"/></Array></mxGeometry></mxCell><mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="map" target="free"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="360" y="195"/></Array></mxGeometry></mxCell><mxCell id="edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="free" target="owner"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.7143;exitDx=0;exitDy=0;entryX=0.0;entryY=0.2857;entryDx=0;entryDy=0;fillColor=#ffe6cc;strokeColor=#d79b00;" edge="1" parent="1" source="owner" target="rnout"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.4545;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="rnout" target="cls"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="790" y="435"/><mxPoint x="790" y="160"/></Array></mxGeometry></mxCell><mxCell id="edge-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.3636;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="cls" target="rob"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#ffe6cc;strokeColor=#d79b00;" edge="1" parent="1" source="rob" target="pay"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="cls" target="sched"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="sched" target="ldq"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1140" y="295"/></Array></mxGeometry></mxCell><mxCell id="edge-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#ffe6cc;strokeColor=#d79b00;" edge="1" parent="1" source="ldq" target="stq"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1460" y="295"/></Array></mxGeometry></mxCell><mxCell id="edge-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="ret" target="push"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=0.0;exitDx=0;exitDy=0;entryX=0.5;entryY=1.0;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="push" target="free"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="585" y="590"/><mxPoint x="360" y="590"/><mxPoint x="360" y="345"/></Array></mxGeometry></mxCell><mxCell id="edge-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=0.0;exitDx=0;exitDy=0;entryX=0.7692;entryY=1.0;entryDx=0;entryDy=0;fillColor=#ffe6cc;strokeColor=#d79b00;" edge="1" parent="1" source="rec" target="free"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="570"/><mxPoint x="430" y="570"/><mxPoint x="430" y="345"/></Array></mxGeometry></mxCell><mxCell id="edge-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=1.0;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="ret" target="cmt"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="205" y="760"/><mxPoint x="1500" y="760"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="Issue and execute" id="block-design-issue-execute"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Issue, register read, execute and writeback" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1000" height="36" as="geometry"/></mxCell><mxCell id="group-0" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Issue (stage 5)&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="560" height="400" as="geometry"/></mxCell><mxCell id="group-1" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Register read&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="620" y="70" width="560" height="400" as="geometry"/></mxCell><mxCell id="group-2" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Execute (stage 6)&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1220" y="70" width="560" height="400" as="geometry"/></mxCell><mxCell id="group-3" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Writeback (stage 7)&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="20" y="510" width="1760" height="250" as="geometry"/></mxCell><mxCell id="sched" value="Scheduler: 12 entries&lt;br&gt;valid, ROB ID, two 6-bit source IDs, readiness bits, class&lt;br&gt;resident wakeup from CDB broadcasts, same-cycle&lt;br&gt;pairwise age matrix across all classes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="520" height="100" as="geometry"/></mxCell><mxCell id="sel01" value="Ports 0 and 1&lt;br&gt;oldest and second-oldest ready&lt;br&gt;ALU or branch entry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="250" height="90" as="geometry"/></mxCell><mxCell id="sel2" value="Port 2&lt;br&gt;oldest ready memory entry first,&lt;br&gt;else multiply/divide or CSR&lt;br&gt;CSR waits for the ROB head" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="310" y="240" width="250" height="90" as="geometry"/></mxCell><mxCell id="wake" value="Wakeup inputs&lt;br&gt;CDB wake view: reset, flush and duplicate suppression only&lt;br&gt;speculative load wake one cycle after a cache-path load request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="520" height="80" as="geometry"/></mxCell><mxCell id="rr01" value="alu_register_read&lt;br&gt;one selection per ALU lane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="640" y="110" width="250" height="70" as="geometry"/></mxCell><mxCell id="rr2" value="aux_register_read&lt;br&gt;port 2 selection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="910" y="110" width="250" height="70" as="geometry"/></mxCell><mxCell id="prf" value="Physical register file&lt;br&gt;two 64 x 32 banks written independently&lt;br&gt;per-register live-writer table picks the bank&lt;br&gt;six asynchronous read ports: four for ports 0 and 1, two for port 2&lt;br&gt;accepted same-cycle writes bypass the read" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="640" y="210" width="520" height="130" as="geometry"/></mxCell><mxCell id="pay" value="Payload array read&lt;br&gt;106-bit context by ROB ID: PC, immediate, controls&lt;br&gt;materialize_uop forms the unit&#x27;s input packet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="640" y="360" width="520" height="80" as="geometry"/></mxCell><mxCell id="alu0" value="ALU 0&lt;br&gt;branch resolve" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1240" y="110" width="160" height="60" as="geometry"/></mxCell><mxCell id="alu1" value="ALU 1&lt;br&gt;branch resolve" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1420" y="110" width="160" height="60" as="geometry"/></mxCell><mxCell id="agu" value="AGU&lt;br&gt;address to LSQ, 1 cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1600" y="110" width="160" height="60" as="geometry"/></mxCell><mxCell id="mdu" value="MDU&lt;br&gt;multiply 4 cycles, divide iterative" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1240" y="190" width="250" height="60" as="geometry"/></mxCell><mxCell id="csr" value="CSR unit&lt;br&gt;1 cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1510" y="190" width="250" height="60" as="geometry"/></mxCell><mxCell id="lsu" value="LSU&lt;br&gt;memory select from registered LSQ state, then issue with a one-row alias check&lt;br&gt;forward from the store queue, or cancel the cache request and bounce&lt;br&gt;atomic sequencer: read, calculate, write, done" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1240" y="270" width="520" height="110" as="geometry"/></mxCell><mxCell id="urr" value="Unit result registers&lt;br&gt;hold ungranted results" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1240" y="400" width="260" height="50" as="geometry"/></mxCell><mxCell id="kill" value="Selective kill&lt;br&gt;clears validity only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1520" y="400" width="240" height="50" as="geometry"/></mxCell><mxCell id="cdb" value="CDB arbiter&lt;br&gt;two results per cycle from six sources&lt;br&gt;rotating priority matrix, exactly-one rank test&lt;br&gt;functional units hold ungranted results" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="520" height="100" as="geometry"/></mxCell><mxCell id="prfw" value="PRF write&lt;br&gt;first successful completion&lt;br&gt;clears busy, writes the value" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="620" y="560" width="250" height="100" as="geometry"/></mxCell><mxCell id="robw" value="ROB completion&lt;br&gt;ready bit, exception, branch result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="900" y="560" width="250" height="100" as="geometry"/></mxCell><mxCell id="wk" value="Wakeup&lt;br&gt;scheduler readiness, LSQ store data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1180" y="560" width="250" height="100" as="geometry"/></mxCell><mxCell id="owner" value="Rename completion check&lt;br&gt;owner, physical destination and&lt;br&gt;recovery age qualify the write" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1460" y="560" width="300" height="100" as="geometry"/></mxCell><mxCell id="page-note" value="Port 0 and 1 serve ALU and branch work. Port 2 serves memory address generation, multiply/divide and CSR work." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1"><mxGeometry x="30" y="770" width="1740" height="24" as="geometry"/></mxCell><mxCell id="edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.2404;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="sched" target="sel01"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.7596;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="sched" target="sel2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.3889;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="sel01" target="rr01"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="590" y="275"/><mxPoint x="590" y="145"/></Array></mxGeometry></mxCell><mxCell id="edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="sel2" target="rr2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="608" y="285"/><mxPoint x="608" y="98"/><mxPoint x="1035" y="98"/></Array></mxGeometry></mxCell><mxCell id="edge-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.2404;entryY=0.0;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="rr01" target="prf"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.7596;entryY=0.0;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="rr2" target="prf"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fillColor=#ffe6cc;strokeColor=#d79b00;" edge="1" parent="1" source="prf" target="pay"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#ffe6cc;strokeColor=#d79b00;" edge="1" parent="1" source="pay" target="alu0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1190" y="400"/><mxPoint x="1190" y="140"/></Array></mxGeometry></mxCell><mxCell id="edge-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.25;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="lsu" target="urr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fillColor=#f5f5f5;strokeColor=#666666;" edge="1" parent="1" source="urr" target="cdb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1370" y="490"/><mxPoint x="300" y="490"/></Array></mxGeometry></mxCell><mxCell id="edge-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="cdb" target="prfw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#ffe6cc;strokeColor=#d79b00;" edge="1" parent="1" source="prfw" target="robw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#ffe6cc;strokeColor=#d79b00;" edge="1" parent="1" source="robw" target="wk"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#ffe6cc;strokeColor=#d79b00;" edge="1" parent="1" source="wk" target="owner"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=1.0;entryDx=0;entryDy=0;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;" edge="1" parent="1" source="wk" target="wake"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1305" y="700"/><mxPoint x="585" y="700"/><mxPoint x="585" y="445"/><mxPoint x="585" y="442"/><mxPoint x="300" y="442"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="Commit and memory" id="block-design-commit-memory"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="780" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Commit, traps and the L1 caches" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1000" height="36" as="geometry"/></mxCell><mxCell id="group-0" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;ROB and commit (stage 8)&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="880" height="460" as="geometry"/></mxCell><mxCell id="group-1" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Traps and CSRs&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="940" y="70" width="440" height="460" as="geometry"/></mxCell><mxCell id="group-2" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Data memory&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1420" y="70" width="360" height="460" as="geometry"/></mxCell><mxCell id="group-3" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;L1 subsystem and backing port&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="20" y="570" width="1760" height="160" as="geometry"/></mxCell><mxCell id="robstat" value="rob_status&lt;br&gt;3 bits per entry:&lt;br&gt;valid, ready, exception" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="260" height="70" as="geometry"/></mxCell><mxCell id="result" value="result_storage&lt;br&gt;32-bit branch outcome:&lt;br&gt;taken bit and target" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="320" y="110" width="270" height="70" as="geometry"/></mxCell><mxCell id="pay" value="Payload array&lt;br&gt;106-bit retirement context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="610" y="110" width="270" height="70" as="geometry"/></mxCell><mxCell id="csrm" value="CSR value storage&lt;br&gt;one RAM writer, the CSR unit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="260" height="70" as="geometry"/></mxCell><mxCell id="stauth" value="Store flags&lt;br&gt;store_authorized_mem&lt;br&gt;head_store_complete_q" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="320" y="200" width="270" height="70" as="geometry"/></mxCell><mxCell id="fence" value="FENCE.I flags&lt;br&gt;head_fence_i_started_q&lt;br&gt;head_fence_i_complete_q" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="610" y="200" width="270" height="70" as="geometry"/></mxCell><mxCell id="logic" value="Commit logic&lt;br&gt;up to two in-order retirements per cycle; control-flow retirement serializes, one branch per cycle&lt;br&gt;a store is authorized only for the head, as a token the load/store queue registers; an atomic only at the head&lt;br&gt;FENCE.I waits for older stores to drain, then maintains both caches" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="840" height="110" as="geometry"/></mxCell><mxCell id="ret" value="Retire ids&lt;br&gt;free registers and load queue entries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="250" height="70" as="geometry"/></mxCell><mxCell id="tok" value="Store token&lt;br&gt;to the load/store queue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="310" y="440" width="250" height="70" as="geometry"/></mxCell><mxCell id="flushc" value="Flush and redirect&lt;br&gt;commit_flush, arch_redirect to the BPU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="580" y="440" width="300" height="70" as="geometry"/></mxCell><mxCell id="csr" value="csr.sv&lt;br&gt;machine-mode CSR bank: mstatus, mie, mip, mtvec,&lt;br&gt;mepc, mcause, mtval, counters; interrupt gating;&lt;br&gt;trap and MRET redirect to direct-mode mtvec" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="960" y="110" width="400" height="110" as="geometry"/></mxCell><mxCell id="oex" value="Oldest-exception record (rob.sv)&lt;br&gt;decode, ALU, AGU and LSU reports carry the ROB tag,&lt;br&gt;cause and tval; at the head they suppress retirement&lt;br&gt;and side effects, then flush speculative state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="960" y="250" width="400" height="110" as="geometry"/></mxCell><mxCell id="irq" value="Interrupt sources&lt;br&gt;machine timer, software, external (UART, test source)&lt;br&gt;from the SoC; taken at commit, and they wait while&lt;br&gt;a store or atomic is authorized" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="960" y="390" width="400" height="110" as="geometry"/></mxCell><mxCell id="lsq" value="Load/store queues&lt;br&gt;12 + 12" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1440" y="110" width="320" height="60" as="geometry"/></mxCell><mxCell id="lsu" value="LSU&lt;br&gt;memory issue, forwarding, atomics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1440" y="200" width="320" height="60" as="geometry"/></mxCell><mxCell id="router" value="dmem_router&lt;br&gt;cacheable to the D-cache&lt;br&gt;MMIO and DMA to uncached AXI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1440" y="290" width="320" height="80" as="geometry"/></mxCell><mxCell id="dcache" value="D-cache (cache.sv)&lt;br&gt;16 KiB, 2-way, 64-byte lines, write-back&lt;br&gt;data RAM: four 32-bit beat banks per way" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1440" y="400" width="320" height="110" as="geometry"/></mxCell><mxCell id="icache" value="I-cache (icache.sv)&lt;br&gt;16 KiB, 2-way, 64-byte lines, 64-bit data banks&lt;br&gt;tag RAM per way, valid and replacement bits in flops" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="380" height="100" as="geometry"/></mxCell><mxCell id="l1" value="cpu_l1_subsystem&lt;br&gt;FENCE.I sequencing: drain, write back, invalidate both&lt;br&gt;4-entry FIFO of accepted I-cache request addresses" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="450" y="610" width="440" height="100" as="geometry"/></mxCell><mxCell id="arb" value="cache_arbiter&lt;br&gt;shares one 128-bit backing line port&lt;br&gt;instruction traffic wins ties" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="920" y="610" width="360" height="100" as="geometry"/></mxCell><mxCell id="port" value="Line port and uncached AXI&lt;br&gt;to the SoC memory and fabric" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1310" y="610" width="440" height="100" as="geometry"/></mxCell><mxCell id="page-note" value="The ROB holds one record per instruction across several arrays, because each field has a different writer and timing." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1"><mxGeometry x="30" y="750" width="1740" height="24" as="geometry"/></mxCell><mxCell id="edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.1488;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="logic" target="ret"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.4702;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="logic" target="tok"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.8214;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="logic" target="flushc"><mxGeometry relative="1" as="geometr