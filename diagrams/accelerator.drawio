" page="1" pageScale="1" pageWidth="1800" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="FIN control and DMA state machines" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1000" height="36" as="geometry"/></mxCell><mxCell id="group-0" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;fin_ctrl: tiled job&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="1760" height="400" as="geometry"/></mxCell><mxCell id="group-1" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;fin_dma: load and store (one command at a time)&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="20" y="500" width="1760" height="280" as="geometry"/></mxCell><mxCell id="s0" value="T_IDLE&lt;br&gt;wait for start" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="220" height="70" as="geometry"/></mxCell><mxCell id="s1" value="T_LATCH&lt;br&gt;snapshot job fields" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="285" y="120" width="220" height="70" as="geometry"/></mxCell><mxCell id="s2" value="T_VALIDATE&lt;br&gt;checks 0 to 4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="530" y="120" width="220" height="70" as="geometry"/></mxCell><mxCell id="s3" value="T_LOAD_A&lt;br&gt;A strip by DMA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="775" y="120" width="220" height="70" as="geometry"/></mxCell><mxCell id="s4" value="T_SETUP_TILE&lt;br&gt;start a C tile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1020" y="120" width="220" height="70" as="geometry"/></mxCell><mxCell id="s5" value="T_LOAD_BIAS&lt;br&gt;N slice, if needed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1265" y="120" width="220" height="70" as="geometry"/></mxCell><mxCell id="s6" value="T_LOAD_B&lt;br&gt;weight tile by DMA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1510" y="120" width="220" height="70" as="geometry"/></mxCell><mxCell id="t0" value="T_PRELOAD&lt;br&gt;prime RAM, load 16 PE rows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="250" height="70" as="geometry"/></mxCell><mxCell id="t1" value="T_COMPUTE&lt;br&gt;feed A rows, drain, accumulate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="325" y="250" width="250" height="70" as="geometry"/></mxCell><mxCell id="t2" value="T_NEXT_K&lt;br&gt;count, advance K or store" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="610" y="250" width="250" height="70" as="geometry"/></mxCell><mxCell id="t3" value="T_STORE&lt;br&gt;DMA the valid C tile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="895" y="250" width="250" height="70" as="geometry"/></mxCell><mxCell id="t4" value="T_NEXT_TILE&lt;br&gt;advance N, then M" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1180" y="250" width="250" height="70" as="geometry"/></mxCell><mxCell id="t5" value="T_DONE&lt;br&gt;status, IRQ latched" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1465" y="250" width="250" height="70" as="geometry"/></mxCell><mxCell id="err" value="T_ERROR&lt;br&gt;validation or AXI error: error status, IRQ latched,&lt;br&gt;then T_IDLE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="520" height="90" as="geometry"/></mxCell><mxCell id="loops" value="Tile loops&lt;br&gt;K inner, then N, then M; the A strip is loaded once per M tile and reused for every N tile&lt;br&gt;more K returns to T_LOAD_B; final K goes to T_STORE; more N returns to T_SETUP_TILE; more M returns to T_LOAD_A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="600" y="350" width="1140" height="90" as="geometry"/></mxCell><mxCell id="d0" value="D_IDLE&lt;br&gt;wait for a command" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="270" height="70" as="geometry"/></mxCell><mxCell id="d1" value="D_LD_ROW&lt;br&gt;last word of the row" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="330" y="550" width="270" height="70" as="geometry"/></mxCell><mxCell id="d2" value="D_LD_AR&lt;br&gt;read address, burst count" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="620" y="550" width="270" height="70" as="geometry"/></mxCell><mxCell id="d3" value="D_LD_R&lt;br&gt;accept a 32-bit beat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="910" y="550" width="270" height="70" as="geometry"/></mxCell><mxCell id="d4" value="D_LD_WR&lt;br&gt;write a byte or word, or pad zero" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1200" y="550" width="270" height="70" as="geometry"/></mxCell><mxCell id="d5" value="D_RSP&lt;br&gt;completion, error bit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1490" y="550" width="270" height="70" as="geometry"/></mxCell><mxCell id="dnote" value="Behavior&lt;br&gt;a burst never reads into the next logical row; elements in the same word are consumed without another beat;&lt;br&gt;padding elements inside the fill rectangle write zero without moving the external address;&lt;br&gt;the store path is a separate state machine with AXI write bursts and a response wait" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="1700" height="100" as="geometry"/></mxCell><mxCell id="page-note" value="T_ states belong to fin_ctrl. D_ states belong to fin_dma. Any validation or AXI error moves the controller to T_ERROR, then idle." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1"><mxGeometry x="30" y="790" width="1740" height="24" as="geometry"/></mxCell><mxCell id="edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.75;exitY=1.0;exitDx=0;exitDy=0;entryX=0.04;entryY=0.0;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="s6" target="t0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1675" y="215"/><mxPoint x="50" y="215"/><mxPoint x="50" y="235"/></Array></mxGeometry></mxCell><mxCell id="edge-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="t0" target="t1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="t1" target="t2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="t2" target="t3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="t3" target="t4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="t4" target="t5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.94;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="t5" target="s0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1700" y="330"/><mxPoint x="1760" y="330"/><mxPoint x="1760" y="100"/><mxPoint x="150" y="100"/></Array></mxGeometry></mxCell><mxCell id="edge-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" edge="1" parent="1" source="d0" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" edge="1" parent="1" source="d3" target="d4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" edge="1" parent="1" source="d4" target="d5"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Systolic array" id="accelerator-array"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="780" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="FIN systolic array detail" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1000" height="36" as="geometry"/></mxCell><mxCell id="group-0" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;One processing element (pe.sv)&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="760" height="410" as="geometry"/></mxCell><mxCell id="group-1" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Array and wavefront&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="820" y="70" width="960" height="410" as="geometry"/></mxCell><mxCell id="group-2" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Scratchpad feeds&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="20" y="510" width="1760" height="230" as="geometry"/></mxCell><mxCell id="w" value="weight_r&lt;br&gt;INT8, loaded by weight_ld" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="170" height="60" as="geometry"/></mxCell><mxCell id="ain" value="a_in&lt;br&gt;INT8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="120" height="60" as="geometry"/></mxCell><mxCell id="vin" value="v_in&lt;br&gt;INT32 from above" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="450" y="100" width="170" height="50" as="geometry"/></mxCell><mxCell id="mul" value="Stage 1&lt;br&gt;pipe_reg &lt;- a_in x weight_r&lt;br&gt;signed 8 x 8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="240" y="160" width="170" height="100" as="geometry"/></mxCell><mxCell id="apipe" value="a_pipe&lt;br&gt;first activation delay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="240" y="300" width="170" height="60" as="geometry"/></mxCell><mxCell id="add" value="Stage 2&lt;br&gt;v_sum_r &lt;- pipe_reg + v_in&lt;br&gt;32-bit, wraps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="450" y="180" width="170" height="80" as="geometry"/></mxCell><mxCell id="aout" value="a_out_r&lt;br&gt;second activation delay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="450" y="300" width="170" height="60" as="geometry"/></mxCell><mxCell id="vout" value="v_out&lt;br&gt;to the PE below" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="650" y="190" width="110" height="60" as="geometry"/></mxCell><mxCell id="aoutp" value="a_out&lt;br&gt;to the right" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="650" y="300" width="110" height="60" as="geometry"/></mxCell><mxCell id="ctl" value="Control&lt;br&gt;preload clears the arithmetic registers while a weight row loads; compute_en advances both stages;&lt;br&gt;otherwise the registers hold. Overflow wraps; saturation happens in postproc after the whole dot product." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="720" height="70" as="geometry"/></mxCell><mxCell id="skew" value="skew_buf&lt;br&gt;row r delayed by r enabled clocks&lt;br&gt;row 0 direct, row 15 fifteen registers&lt;br&gt;turns a vertical wall of A values&lt;br&gt;into a diagonal wave" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="840" y="120" width="250" height="200" as="geometry"/></mxCell><mxCell id="grid" value="sys_arr: 16 x 16 PE grid&lt;br&gt;A moves left to right, partial sums top to bottom&lt;br&gt;PE row r holds B[r][n] for K position r&lt;br&gt;PE column c produces N position c&lt;br&gt;the bottom of column c gives one C[m][c]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1120" y="120" width="380" height="200" as="geometry"/></mxCell><mxCell id="desk" value="Output deskew&lt;br&gt;aligns the column results" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1530" y="120" width="230" height="90" as="geometry"/></mxCell><mxCell id="fold" value="K-tile fold, postproc&lt;br&gt;accumulate, then bias, shift,&lt;br&gt;saturate, ReLU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1530" y="230" width="230" height="90" as="geometry"/></mxCell><mxCell id="tbl" value="Schedule for N = 16&lt;br&gt;compute counter runs 0 to 72&lt;br&gt;preload: prime cycle, then weight_ld[0] to [15]&lt;br&gt;first aligned C row at counter 47, last at 62&lt;br&gt;raw writes 47 to 62, post-processed 50 to 65" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1340" y="350" width="420" height="120" as="geometry"/></mxCell><mxCell id="fw" value="Weight scratchpad to the PE rows&lt;br&gt;16 weights per K row, read synchronously;&lt;br&gt;preload loads one PE row per cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="560" height="100" as="geometry"/></mxCell><mxCell id="fa" value="Activation scratchpad to skew_buf&lt;br&gt;four 32-bit banks of four byte lanes give&lt;br&gt;16 INT8 values per cycle for one M row" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="640" y="560" width="560" height="100" as="geometry"/></mxCell><mxCell id="fo" value="Output scratchpad&lt;br&gt;one RAM per column; a compute write stores&lt;br&gt;a whole C row in one cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1240" y="560" width="500" height="100" as="geometry"/></mxCell><mxCell id="fn" value="Every PE works during a tile, including zero-padded edge lanes; useful work is counted separately; no sparsity detection or rounding in the array" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="1700" height="40" as="geometry"/></mxCell><mxCell id="page-note" value="Rows are K positions, columns are N positions, and time carries successive M rows through the array." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1"><mxGeometry x="30" y="750" width="1740" height="24" as="geometry"/></mxCell><mxCell id="edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.8333;exitDx=0;exitDy=0;entryX=0.0;entryY=0.1;entryDx=0;entryDy=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" edge="1" parent="1" source="w" target="mul"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.3333;exitDx=0;exitDy=0;entryX=0.0;entryY=0.8;entryDx=0;entryDy=0;fillColor=#f5f5f5;strokeColor=#666666;" edge="1" parent="1" source="ain" target="mul"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#f5f5f5;strokeColor=#666666;" edge="1" parent="1" source="ain" target="apipe"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="100" y="330"/></Array></mxGeometry></mxCell><mxCell id="edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.6;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="mul" target="add"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fillColor=#f5f5f5;strokeColor=#666666;" edge="1" parent="1" source="vin" target="add"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="add" target="vout"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="apipe" target="aout"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="aout" target="aoutp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="skew" target="grid"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.225;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#d5e8d4;strokeColor=#82b366;" edge="1" parent="1" source="grid" target="desk"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="desk" target="fold"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5714;exitY=0.0;exitDx=0;exitDy=0;entryX=0.48;entryY=1.0;entryDx=0;entryDy=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" edge="1" parent="1" source="fa" target="skew"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="960" y="540"/><mxPoint x="960" y="325"/></Array></mxGeometry></mxCell><mxCell id="edge-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=0.0;exitDx=0;exitDy=0;entryX=0.4737;entryY=1.0;entryDx=0;entryDy=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" edge="1" parent="1" source="fw" target="grid"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="320" y="535"/><mxPoint x="1300" y="535"/><mxPoint x="1300" y="325"/></Array></mxGeometry></mxCell><mxCell id="edge-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="fold" target="fo"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1790" y="275"/><mxPoint x="1790" y="535"/><mxPoint x="1490" y="535"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>