okeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="850" y="450" width="200" height="60" as="geometry"/></mxCell><mxCell id="wsp" value="Weight scratchpad&lt;br&gt;16 x 16 INT8, 4 banks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1100" y="220" width="220" height="70" as="geometry"/></mxCell><mxCell id="asp" value="Activation scratchpad&lt;br&gt;16 x 1024 INT8, transposed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1100" y="310" width="220" height="70" as="geometry"/></mxCell><mxCell id="bsp" value="Bias scratchpad&lt;br&gt;16 x INT32" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1100" y="400" width="220" height="70" as="geometry"/></mxCell><mxCell id="skew" value="skew_buf&lt;br&gt;row delays form the wavefront" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1370" y="220" width="260" height="70" as="geometry"/></mxCell><mxCell id="arr" value="sys_arr: 16 x 16 PE grid&lt;br&gt;weight stationary, two-stage PE&lt;br&gt;INT8 x INT8, 32-bit accumulate&lt;br&gt;rows = K, columns = N, time = M" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1370" y="320" width="260" height="170" as="geometry"/></mxCell><mxCell id="deskew" value="Output deskew&lt;br&gt;aligns column results" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1370" y="520" width="260" height="60" as="geometry"/></mxCell><mxCell id="fold" value="K-tile accumulate&lt;br&gt;partial-sum fold" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1370" y="610" width="260" height="60" as="geometry"/></mxCell><mxCell id="post" value="postproc&lt;br&gt;bias, shift, saturate to INT8&lt;br&gt;optional ReLU, 3 stages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1370" y="700" width="260" height="80" as="geometry"/></mxCell><mxCell id="osp" value="Output scratchpad&lt;br&gt;16 x 16 INT32, banked&lt;br&gt;read by window and DMA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1100" y="700" width="220" height="80" as="geometry"/></mxCell><mxCell id="text-0" value="Two programming modes" style="text;html=1;verticalAlign=middle;align=left;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="824" width="600" height="24" as="geometry"/></mxCell><mxCell id="text-1" value="Tiled: one M x K by K x N job, hardware loops and edge tiles." style="text;html=1;verticalAlign=middle;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="849" width="600" height="24" as="geometry"/></mxCell><mxCell id="text-2" value="Raw: one 16 x 16 x 16 operation, software chains launches with acc_en;" style="text;html=1;verticalAlign=middle;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="869" width="600" height="24" as="geometry"/></mxCell><mxCell id="text-3" value="raw mode stores the full INT32 sum and skips post-processing." style="text;html=1;verticalAlign=middle;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="889" width="600" height="24" as="geometry"/></mxCell><mxCell id="text-4" value="Limits" style="text;html=1;verticalAlign=middle;align=left;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1370" y="824" width="600" height="24" as="geometry"/></mxCell><mxCell id="text-5" value="K &lt;= 1024 (activation scratchpad depth)" style="text;html=1;verticalAlign=middle;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1370" y="849" width="600" height="24" as="geometry"/></mxCell><mxCell id="