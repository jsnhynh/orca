<mxfile host="app.diagrams.net"><diagram name="Overview" id="m-extension"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="840" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="M extension: multiply and divide unit" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1000" height="36" as="geometry"/></mxCell><mxCell id="group-0" value="&lt;b&gt;Multiply (pipelined)&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=60;verticalAlign=top;align=center;spacingTop=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="120" width="560" height="280" as="geometry"/></mxCell><mxCell id="group-1" value="&lt;b&gt;Divide (iterative)&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=60;verticalAlign=top;align=center;spacingTop=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="440" width="560" height="280" as="geometry"/></mxCell><mxCell id="sch" value="&lt;b&gt;Scheduler&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;port 2, oldest ready&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="160" height="80" as="geometry"/></mxCell><mxCell id="rr" value="&lt;b&gt;Register read&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;rs1, rs2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="160" height="80" as="geometry"/></mxCell><mxCell id="in" value="&lt;b&gt;Input register&lt;/b&gt;&lt;br&gt;&lt;