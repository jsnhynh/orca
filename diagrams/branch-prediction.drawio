<mxfile host="app.diagrams.net"><diagram name="Overview" id="branch-prediction"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Branch prediction unit" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1000" height="36" as="geometry"/></mxCell><mxCell id="group-0" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Cycle n: next-PC selection&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="560" height="320" as="geometry"/></mxCell><mxCell id="group-1" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Cycle n+1: L1 tables answer with the I-cache response&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="620" y="60" width="600" height="320" as="geometry"/></mxCell><mxCell id="group-2" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;L1 verdict and repair&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1260" y="60" width="520" height="320" as="geometry"/></mxCell><mxCell id="group-3" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Allocation and tracking&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="20" y="430" width="760" height="330" as="geometry"/></mxCell><mxCell id="group-4" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Resolution and training&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="820" y="430" width="960" height="330" as="geometry"/></mxCell><mxCell id="r1" value="1 Architectural&lt;br&gt;trap, MRET, FENCE.I" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="200" height="50" as="geometry"/></mxCell><mxCell id="r2" value="2 Commit backstop&lt;br&gt;commit_flush" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="185" width="200" height="50" as="geometry"/></mxCell><mxCell id="r3" value="3 Execute recovery&lt;br&gt;recovery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="200" height="50" as="geometry"/></mxCell><mxCell id="r4" value="4 L1 repair&lt;br&gt;pred_redirect_val" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="315" width="200" height="50" as="geometry"/></mxCell><mxCell id="pc" value="Fetch PC&lt;br&gt;aligned group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="120" width="110" height="60" as="geometry"/></mxCell><mxCell id="l0" value="L0 BTB&lt;br&gt;128, LUTRAM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="430" y="120" width="130" height="60" as="geometry"/></mxCell><mxCell id="mux" value="Next-PC select&lt;br&gt;highest priority redirect wins,&lt;br&gt;else L0 target, else sequential" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="300" y="220" width="260" height="100" as="geometry"/></mxCell><mxCell id="btb" value="BTB&lt;br&gt;512 entries, banked BRAM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="650" y="120" width="200" height="60" as="geometry"/></mxCell><mxCell id="base" value="TAGE base&lt;br&gt;512 bimodal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="650" y="195" width="200" height="50" as="geometry"/></mxCell><mxCell id="tagged" value="TAGE tagged tables&lt;br&gt;4 x 1024 entries&lt;br&gt;history lengths 5, 12, 28, 64&lt;br&gt;valid bit stored in the RAM word" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="880" y="120" width="270" height="130" as="geometry"/></mxCell><mxCell id="ras" value="RAS&lt;br&gt;16 entries, speculative top" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="650" y="270" width="200" height="60" as="geometry"/></mxCell><mxCell id="ghr" value="Global history&lt;br&gt;64 bits, speculative + retained" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="880" y="270" width="270" height="60" as="geometry"/></mxCell><mxCell id="bus" value=" " style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1170" y="120" width="24" height="210" as="geometry"/></mxCell><mxCell id="verdict" value="L1 verdict&lt;br&gt;agrees with L0: continue&lt;br&gt;differs: hold one cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1290" y="120" width="220" height="100" as="geometry"/></mxCell><mxCell id="meta" value="Prediction metadata&lt;br&gt;provider, alternate, strength" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1290" y="250" width="220" height="70" as="geometry"/></mxCell><mxCell id="hold" value="Repair&lt;br&gt;pred_hold, registered redirect&lt;br&gt;one-cycle transaction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1540" y="120" width="220" height="100" as="geometry"/></mxCell><mxCell id="alloc" value="BPU alloc control&lt;br&gt;FTQ enqueue, speculative GHR&lt;br&gt;and RAS updates from the fetch packet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="50" y="480" width="320" height="90" as="geometry"/></mxCell><mxCell id="ftq" value="FTQ&lt;br&gt;16 entries, payload in two banks&lt;br&gt;PC, prediction, GHR checkpoint,&lt;br&gt;RAS checkpoint, return flag,&lt;br&gt;valid and recovered bits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="410" y="480" width="340" height="140" as="geometry"/></mxCell><mxCell id="retflag" value="Return-pending flag&lt;br&gt;registered; selects RAS bypass" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="410" y="650" width="340" height="70" as="geometry"/></mxCell><mxCell id="exec" value="Execute recover&lt;br&gt;ALU branch result against the FTQ entry&lt;br&gt;oldest by circular distance from the&lt;br&gt;ROB head raises recovery (3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x=