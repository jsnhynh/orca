0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="verdict" target="meta"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-16" value="repair" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=0.0;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;" edge="1" parent="1" source="hold" target="r4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1650" y="52"/><mxPoint x="30" y="52"/><mxPoint x="30" y="340"/></Array></mxGeometry></mxCell><mxCell id="edge-17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="meta" target="alloc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1400" y="405"/><mxPoint x="210" y="405"/></Array></mxGeometry></mxCell><mxCell id="edge-18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.3214;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="alloc" target="ftq"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fillColor=#ffe6cc;strokeColor=#d79b00;" edge="1" parent="1" source="ftq" target="retflag"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1.0;entryDx=0;entryDy=0;fillColor=#ffe6cc;strokeColor=#d79b00;" edge="1" parent="1" source="retflag" target="alloc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="300" y="685"/><mxPoint x="210" y="685"/></Array></mxGeometry></mxCell><mxCell id="edge-21" value="entry lookup" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.3571;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#ffe6cc;strokeColor=#d79b00;" edge="1" parent="1" source="ftq" target="exec"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="exec" target="commitc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1145" y="530"/></Array></mxGeometry></mxCell><mxCell id="edge-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="commitc" target="train"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.2373;entryY=0.0;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="exec" target="flush"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="990" y="600"/></Array></mxGeometry></mxCell><mxCell id="edge-25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.7627;entryY=0.0;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="commitc" target="flush"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1300" y="600"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="TAGE" id="branch-prediction-tage"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="TAGE detail" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1000" height="36" as="geometry"/></mxCell><mxCell id="group-0" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Inputs&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="460" height="330" as="geometry"/></mxCell><mxCell id="group-1" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Lookup in cycle n, answer in cycle n+1&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="520" y="70" width="800" height="330" as="geometry"/></mxCell><mxCell id="group-2" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Selection and metadata&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1380" y="70" width="400" height="330" as="geometry"/></mxCell><mxCell id="group-3" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Training (at commit only)&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="20" y="440" width="1760" height="320" as="geometry"/></mxCell><mxCell id="pc" value="Fetch PC&lt;br&gt;index uses pc[11:2], tag uses pc[19:12]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="420" height="60" as="geometry"/></mxCell><mxCell id="ghr" value="Global history register&lt;br&gt;64 bits, speculative copy plus retained copy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="420" height="60" as="geometry"/></mxCell><mxCell id="fold" value="Registered folds&lt;br&gt;idx_fold_q[t] and tag_fold_q[t] per table&lt;br&gt;every candidate history is folded in parallel:&lt;br&gt;execute recovery, commit recovery, speculative shift" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="420" height="110" as="geometry"/></mxCell><mxCell id="tb" value="Base table&lt;br&gt;512-entry bimodal fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="540" y="110" width="360" height="60" as="geometry"/></mxCell><mxCell id="t0" value="Tagged table 0&lt;br&gt;1024 entries, history 5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="540" y="190" width="360" height="50" as="geometry"/></mxCell><mxCell id="t1" value="Tagged table 1&lt;br&gt;1024 entries, history 12" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="540" y="250" width="360" height="50" as="geometry"/></mxCell><mxCell id="t2" value="Tagged table 2&lt;br&gt;1024 entries, history 28" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="540" y="310" width="360" height="50" as="geometry"/></mxCell><mxCell id="t3" value="Tagged table 3&lt;br&gt;1024 entries, history 64" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="920" y="190" width="380" height="50" as="geometry"/></mxCell><mxCell id="word" value="Entry word&lt;br&gt;tag, prediction counters, useful bits, valid bit&lt;br&gt;the valid bit lives in the RAM word;&lt;br&gt;a post-reset sweep clears it (256 or 512 cycles)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="920" y="250" width="380" height="110" as="geometry"/></mxCell><mxCell id="prov" value="Provider select&lt;br&gt;longest matching history wins;&lt;br&gt;tables walked in ascending order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1400" y="110" width="360" height="90" as="geometry"/></mxCell><mxCell id="alt" value="alt_pred and alloc_table&lt;br&gt;what the previous provider would say;&lt;br&gt;first table above with useful = 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1400" y="220" width="360" height="80" as="geometry"/></mxCell><mxCell id="pred" value="pred_taken&lt;br&gt;carried in the FTQ entry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1400" y="320" width="360" height="60" as="geometry"/></mxCell><mxCell id="train" value="Training write&lt;br&gt;allocation policy is fixed at prediction time,&lt;br&gt;so training is a direct RAM write, not a second read;&lt;br&gt;the lookup history is carried in the FTQ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="560" height="110" as="geometry"/></mxCell><mxCell id="use" value="Useful-bit decay&lt;br&gt;a counter ticks on every training update;&lt;br&gt;on overflow a sweep walks every index&lt;br&gt;clearing one useful bit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="640" y="490" width="560" height="110" as="geometry"/></mxCell><mxCell id="rec" value="History recovery&lt;br&gt;commit sets recover_history only when execute has not;&lt;br&gt;ghr_cp in the FTQ restores an exact history&lt;br&gt;including slot 0&#x27;s speculative outcome in slot 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1240" y="490" width="500" height="110" as="geometry"/></mxCell><mxCell id="size" value="Why this size&lt;br&gt;a CoreMark sweep of tables, entries and histories picked four 1024-entry tables with histories 5, 12, 28, 64; mispredicts fell from 13,714 to 7,873,&lt;br&gt;TAGE direction accuracy rose from 97.75% to 98.86%, and a 128-bit history was ruled out because it would double the history checkpoint&lt;br&gt;held in every FTQ entry, which sits on a critical path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="630" width="1700" height="100" as="geometry"/></mxCell><mxCell id="page-note" value="Index and tag are folded history XOR PC bits. The folds are registered, so a lookup has no wide XOR tree in front of the RAM address." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1"><mxGeometry x="30" y="770" width="1740" height="24" as="geometry"/></mxCell><mxCell id="edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" edge="1" parent="1" source="pc" target="tb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="490" y="140"/></Array></mxGeometry></mxCell><mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.2727;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="fold" target="t0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="300"/><mxPoint x="500" y="215"/></Array></mxGeometry></mxCell><mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.3333;entryDx=0;entryDy=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" edge="1" parent="1" source="tb" target="prov"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1330" y="140"/></Array></mxGeometry></mxCell><mxCell id="edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" edge="1" parent="1" source="t3" target="prov"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1340" y="215"/><mxPoint x="1340" y="155"/></Array></mxGeometry></mxCell><mxCell id="edge-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="prov" target="alt"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="alt" target="pred"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" edge="1" parent="1" source="ghr" target="fold"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="FTQ and recovery" id="branch-prediction-ftq"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="FTQ and recovery detail" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1000" height="36" as="geometry"/></mxCell><mxCell id="group-0" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;FTQ entry (ftq_entry_t)&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="860" height="420" as="geometry"/></mxCell><mxCell id="group-1" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Redirect sources, highest priority first&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="920" y="70" width="860" height="420" as="geometry"/></mxCell><mxCell id="group-2" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Flush kinds&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="20" y="530" width="1760" height="220" as="geometry"/></mxCell><mxCell id="e1" value="pc&lt;br&gt;fetch group address" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="400" height="60" as="geometry"/></mxCell><mxCell id="e2" value="pred: branch_pred_t&lt;br&gt;BTB hit, branch type, target; TAGE provider data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="460" y="110" width="400" height="60" as="geometry"/></mxCell><mxCell id="e3" value="ghr_cp&lt;br&gt;global history at allocation, for recovery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="400" height="60" as="geometry"/></mxCell><mxCell id="e4" value="ras_cp&lt;br&gt;RAS pointer checkpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="460" y="190" width="400" height="60" as="geometry"/></mxCell><mxCell id="e5" value="valid and execute_recovered flags&lt;br&gt;mutated by recovery, kept apart from the payload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="400" height="60" as="geometry"/></mxCell><mxCell id="e6" value="return flag and initialized mask&lt;br&gt;return scan, reset mask for zero reads" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="460" y="270" width="400" height="60" as="geometry"/></mxCell><mxCell id="e7" value="Storage&lt;br&gt;16 entries; the payload sits in two banks with asynchronous reads;&lt;br&gt;a registered return-pending flag (the or of surviving returns and this cycle&#x27;s enqueued returns)&lt;br&gt;selects the RAS bypass, so prediction starts from one flop instead of 16 entries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="820" height="100" as="geometry"/></mxCell><mxCell id="r1" value="1 Architectural: trap, MRET, FENCE.I&lt;br&gt;registered arch_redirect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="940" y="110" width="820" height="70" as="geometry"/></mxCell><mxCell id="r2" value="2 Commit backstop&lt;br&gt;commit compares the architectural outcome with the oldest FTQ entry and flushes if they disagree and execute did not repair it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="940" y="200" width="820" height="70" as="geometry"/></mxCell><mxCell id="r3" value="3 Execute recovery&lt;br&gt;an ALU result is compared with its FTQ entry; among several, the smallest circular distance from the ROB head wins" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="940" y="290" width="820" height="70" as="geometry"/></mxCell><mxCell id="r4" value="4 L1 repair&lt;br&gt;L1 disagrees with L0, or L0 had nothing and L1 says taken: hold one cycle, then redirect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="940" y="380" width="820" height="70" as="geometry"/></mxCell><mxCell id="f1" value="flush&lt;br&gt;union of commit, execute recovery and architectural redirect;&lt;br&gt;kills the front end and younger speculative work&lt;br&gt;execute recovery is selective and keeps older work" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="820" height="130" as="geometry"/></mxCell><mxCell id="f2" value="full_flush&lt;br&gt;commit and architectural redirects only;&lt;br&gt;also wipes rename, the ROB and the issue queues&lt;br&gt;branch checkpoints and the free-list head are restored from the commit state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="920" y="580" width="840" height="130" as="geometry"/></mxCell><mxCell id="page-note" value="The FTQ keeps what is needed to check and undo each prediction. Four redirect sources are prioritized." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1"><mxGeometry x="30" y="770" width="1740" height="24" as="geometry"/></mxCell><mxCell id="edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="e2" target="e1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fillColor=#f5f5f5;strokeColor=#666666;" edge="1" parent="1" source="r1" target="r2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fillColor=#f5f5f5;strokeColor=#666666;" edge="1" parent="1" source="r2" target="r3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fillColor=#f5f5f5;strokeColor=#666666;" edge="1" parent="1" source="r3" target="r4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.0;entryY=0.4615;entryDx=0;entryDy=0;fillColor=#f5f5f5;strokeColor=#666666;" edge="1" parent="1" source="r1" target="f2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1780" y="145"/><mxPoint x="1780" y="640"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>