;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;0x8000_2000&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="960" y="600" width="200" height="80" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b&gt;SoC CSRs&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;0x8000_3000&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="960" y="680" width="200" height="80" as="geometry"/></mxCell><mxCell id="p4" value="&lt;b&gt;Host console&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;0x8000_4000&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="960" y="760" width="200" height="80" as="geometry"/></mxCell><mxCell id="ps" value="&lt;b&gt;Processing system&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Arm cores, HP0 port&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;128-bit AXI4&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1240" y="160" width="440" height="120" as="geometry"/></mxCell><mxCell id="psddr" value="&lt;b&gt;PS DDR&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;256 MiB reserved&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1240" y="320" width="440" height="80" as="geometry"/></mxCell><mxCell id="top" value="&lt;b&gt;orca_pl_top&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;host aperture, UART TX,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;six status LEDs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=