<mxfile host="app.diagrams.net"><diagram name="Overview" id="soc"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="ORCA SoC design" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1000" height="36" as="geometry"/></mxCell><mxCell id="group-0" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Initiators&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="340" height="560" as="geometry"/></mxCell><mxCell id="group-1" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Memory path&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="400" y="70" width="960" height="270" as="geometry"/></mxCell><mxCell id="group-2" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Fabric and peripherals&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="400" y="360" width="960" height="340" as="geometry"/></mxCell><mxCell id="group-3" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Platform&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1400" y="70" width="380" height="630" as="geometry"/></mxCell><mxCell id="cpu" value="Out-of-order CPU&lt;br&gt;RV32IMA, Zicsr, Zifencei&lt;br&gt;L1 I-cache and D-cache, 16 KiB each" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="300" height="110" as="geometry"/></mxCell><mxCell id="stop" value="CPU stop control&lt;br&gt;running, draining, held" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="140" height="60" as="geometry"/></mxCell><mxCell id="irq" value="Interrupt levels&lt;br&gt;timer, UART, test source" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="200" y="250" width="140" height="60" as="geometry"/></mxCell><mxCell id="host" value="Host AXI&lt;br&gt;from the PS, 128 KiB aperture&lt;br&gt;translated to DMA and MMIO windows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="300" height="90" as="geometry"/></mxCell><mxCell id="router" value="L1 router&lt;br&gt;address decode&lt;br&gt;128-bit line port + 32-bit uncached AXI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="430" y="110" width="260" height="110" as="geometry"/></mxCell><mxCell id="guard" value="DMA region route&lt;br&gt;uncached 16 KiB window only,&lt;br&gt;32 to 128-bit, into the DDR mux" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="790" y="110" width="250" height="80" as="geometry"/></mxCell><mxCell id="mem" value="Boot ROM&lt;br&gt;4 KiB at 0, the only local memory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1100" y="110" width="240" height="80" as="geometry"/></mxCell><mxCell id="ddrb" value="DDR line bridge and mux&lt;br&gt;ORCA 0x1000_0000, 256 MiB&lt;br&gt;to PS 0x7000_0000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="790" y="230" width="250" height="80" as="geometry"/></mxCell><mxCell id="xbar" value="PULP AXI crossbar&lt;br&gt;initiators: CPU uncached,&lt;br&gt;host&lt;br&gt;targets: memory route,&lt;br&gt;peripheral route&lt;br&gt;every channel cut" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="430" y="400" width="260" height="230" as="geometry"/></mxCell><mxCell id="lite" value="AXI to AXI-Lite&lt;br&gt;then AXI-Lite crossbar&lt;br&gt;4 KiB pages, one transaction per port" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="790" y="440" width="250" height="110" as="geometry"/></mxCell><mxCell id="p2" value="UART 0x8000_1000&lt;br&gt;AXI-Lite to APB, PULP UART" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1100" y="450" width="240" height="50" as="geometry"/></mxCell><mxCell id="p3" value="Timer 0x8000_2000&lt;br&gt;CLINT view at 0x8001_0000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1100" y="510" width="240" height="50" as="geometry"/></mxCell><mxCell id="p4" value="SoC CSRs 0x8000_3000&lt;br&gt;boot and stop controls" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1100" y="570" width="240" height="50" as="geometry"/></mxCell><mxCell id="p5" value="Host console 0x8000_4000&lt;br&gt;host side of the console" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1100" y="630" width="240" height="50" as="geometry"/></mxCell><mxCell id="ps" value="Processing system&lt;br&gt;Arm cores, HP0 port (128-bit AXI4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1420" y="110" width="340" height="90" as="geometry"/></mxCell><mxCell id="psddr" value="PS DDR&lt;br&gt;256 MiB reserved, no-map" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1420" y="230" width="340" height="70" as="geometry"/></mxCell><mxCell id="top" value="orca_kv260_top&lt;br&gt;one clock domain&lt;br&gt;reset, clock, UART TX, host aperture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1420" y="340" width="340" height="100" as="geometry"/></mxCell><mxCell id="clk" value="Clock&lt;br&gt;one clock, 150 MHz&lt;br&gt;reset release synchronized" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1420" y="470" width="340" height="110" as="geometry"/></mxCell><mxCell id="text-0" value="No cache coherence. Shared buffers use the" style="text;html=1;verticalAlign=middle;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1420" y="604" width="600" height="24" as="geometry"/></mxCell><mxCell id="text-1" value="uncached DMA window." style="text;html=1;verticalAlign=middle;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1420" y="624" width="600" height="24" as="geometry"/></mxCell><mxCell id="page-note" value="Solid arrows: data paths. Dashed arrows: control and interrupts. Addresses are ORCA addresses; the host aperture is 128 KiB at 0xA400_0000 in the PS map." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1"><mxGeometry x="30" y="770" width="1740" height="24" as="geometry"/></mxCell><mxCell id="edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="cpu" target="router"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="385" y="165"/></Array></mxGeometry></mxCell><mxCell id="edge-1" value="128-bit lines (boot ROM)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=0.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fillColor=#f5f5f5;strokeColor=#666666;" edge="1" parent="1" source="router" target="mem"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="92"/><mxPoint x="740" y="92"/><mxPoint x="1220" y="92"/></Array></mxGeometry></mxCell><mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#f5f5f5;strokeColor=#666666;" edge="1" parent="1" source="router" target="ddrb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="270"/><mxPoint x="760" y="270"/></Array></mxGeometry></mxCell><mxCell id="edge-3" value="32-bit uncached AXI" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fillColor=#f5f5f5;strokeColor=#666666;" edge="1" parent="1" source="router" target="xbar"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="330"/></Array></mxGeometry></mxCell><mxCell id="edge-4" value="host AXI" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5556;exitDx=0;exitDy=0;entryX=0.0;entryY=0.6957;entryDx=0;entryDy=0;fillColor=#d5e8d4;strokeColor=#82b366;" edge="1" parent="1" source="host" target="xbar"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="385" y="560"/></Array></mxGeometry></mxCell><mxCell id="edge-5" value="memory route" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#f5f5f5;strokeColor=#666666;" edge="1" parent="1" source="xbar" target="guard"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="740" y="515"/><mxPoint x="740" y="150"/></Array></mxGeometry></mxCell><mxCell id="edge-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fillColor=#e1d5e7;strokeColor=#9673a6;" edge="1" parent="1" source="guard" target="ddrb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-7" value="peripheral route" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.413;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#f5f5f5;strokeColor=#666666;" edge="1" parent="1" source="xbar" target="lite"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#f5f5f5;strokeColor=#666666;" edge="1" parent="1" source="lite" target="p2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1070" y="495"/><mxPoint x="1070" y="475"/></Array></mxGeometry></mxCell><mxCell id="edge-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#f5f5f5;strokeColor=#666666;" edge="1" parent="1" source="lite" target="p3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1070" y="495"/><mxPoint x="1070" y="535"/></Array></mxGeometry></mxCell><mxCell id="edge-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#f5f5f5;strokeColor=#666666;" edge="1" parent="1" source="lite" target="p4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1070" y="495"/><mxPoint x="1070" y="595"/></Array></mxGeometry></mxCell><mxCell id="edge-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#f5f5f5;strokeColor=#666666;" edge="1" parent="1" source="lite" target="p5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1070" y="495"/><mxPoint x="1070" y="655"/></Array></mxGeometry></mxCell><mxCell id="edge-12" value="M_AXI_DDR" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#e1d5e7;strokeColor=#9673a6;" edge="1" parent="1" source="ddrb" target="ps"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1390" y="270"/><mxPoint x="1390" y="155"/></Array></mxGeometry></mxCell><mxCell id="edge-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fillColor=#d5e8d4;strokeColor=#82b366;" edge="1" parent="1" source="ps" target="psddr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=0.0;exitDx=0;exitDy=0;entryX=0.2333;entryY=1.0;entryDx=0;entryDy=0;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" edge="1" parent="1" source="stop" target="cpu"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=0.0;exitDx=0;exitDy=0;entryX=0.7667;entryY=1.0;entryDx=0;entryDy=0;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" edge="1" parent="1" source="irq" target="cpu"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Address map" id="soc-address-map"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="ORCA address map" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1000" height="36" as="geometry"/></mxCell><mxCell id="group-0" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;ORCA address space&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="1100" height="600" as="geometry"/></mxCell><mxCell id="group-1" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Host aperture (PS 0xA400_0000, 128 KiB)&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1160" y="70" width="620" height="460" as="geometry"/></mxCell><mxCell id="a1" value="0x0000_0000 to 0x0000_0fff&lt;br&gt;boot ROM, 4 KiB, the only on-chip memory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="500" height="50" as="geometry"/></mxCell><mxCell id="a2" value="0x0000_1000 to 0x0fff_ffff&lt;br&gt;no storage: line reads return zero, writes are discarded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="500" height="50" as="geometry"/></mxCell><mxCell id="a3" value="0x1000_0000 to 0x1fff_bfff&lt;br&gt;PS DDR window, cached, maps to PS 0x7000_0000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="500" height="50" as="geometry"/></mxCell><mxCell id="a4" value="0x1fff_c000 to 0x1fff_ffff&lt;br&gt;uncached DMA region, 16 KiB, shared by CPU and host" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="500" height="50" as="geometry"/></mxCell><mxCell id="a5" value="0x2000_0000 to 0x7fff_ffff&lt;br&gt;no storage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="500" height="50" as="geometry"/></mxCell><mxCell id="p1" value="0x8000_0000 to 0x8000_0fff&lt;br&gt;no target: the AXI-Lite crossbar returns a decode error" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="580" y="110" width="520" height="50" as="geometry"/></mxCell><mxCell id="p2" value="0x8000_1000 to 0x8000_1fff&lt;br&gt;UART: AXI-Lite to APB, PULP UART" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="580" y="170" width="520" height="50" as="geometry"/></mxCell><mxCell id="p3" value="0x8000_2000 to 0x8000_2fff&lt;br&gt;machine timer: mtime, mtimecmp, msip, test interrupt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="580" y="230" width="520" height="50" as="geometry"/></mxCell><mxCell id="p4" value="0x8000_3000 to 0x8000_3fff&lt;br&gt;SoC CSRs: host boot controls, partial status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="580" y="290" width="520" height="50" as="geometry"/></mxCell><mxCell id="p5" value="0x8000_4000 to 0x8000_4fff&lt;br&gt;host console UART (host side of the console)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="580" y="350" width="520" height="50" as="geometry"/></mxCell><mxCell id="p6" value="0x8001_0000 to 0x8001_ffff&lt;br&gt;CLINT view of the machine timer, for Linux" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="580" y="410" width="520" height="50" as="geometry"/></mxCell><mxCell id="p7" value="everything else above 0x8000_0000&lt;br&gt;no target: the access returns a bus error" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="580" y="470" width="520" height="50" as="geometry"/></mxCell><mxCell id="h1" value="0x00000 to 0x03fff&lt;br&gt;maps to ORCA 0x1fff_c000 to 0x1fff_ffff, the DMA region" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1180" y="110" width="580" height="60" as="geometry"/></mxCell><mxCell id="h2" value="0x04000 to 0x0ffff&lt;br&gt;mapped to zero: the crossbar returns a decode error" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1180" y="190" width="580" height="60" as="geometry"/></mxCell><mxCell id="h3" value="0x10000 to 0x14fff&lt;br&gt;maps to ORCA 0x8000_0000 to 0x8000_4fff, the MMIO pages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1180" y="270" width="580" height="60" as="geometry"/></mxCell><mxCell id="h4" value="0x15000 to 0x1ffff&lt;br&gt;mapped to zero: the crossbar returns a decode error" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1180" y="350" width="580" height="60" as="geometry"/></mxCell><mxCell id="text-0" value="Decode" style="text;html=1;verticalAlign=middle;align=left;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="544" width="600" height="24" as="geometry"/></mxCell><mxCell id="text-1" value="the cached DDR window and the boot ROM are reached only through the CPU&#x27;s 128-bit line port" style="text;html=1;verticalAlign=middle;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="569" width="600" height="24" as="geometry"/></mxCell><mxCell id="text-2" value="the AXI crossbar has two targets: the DMA region, and everything from 0x8000_0000 (peripherals);" style="text;html=1;verticalAlign=middle;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="589" width="600" height="24" as="geometry"/></mxCell><mxCell id="text-3" value="any other AXI address, cached DDR included, receives a decode error" style="text;html=1;verticalAlign=middle;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="609" width="600" height="24" as="geometry"/></mxCell><mxCell id="text-4" value="Peripheral pages are 4 KiB. The AXI-Lite crossbar has no default target." style="text;html=1;verticalAlign=middle;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="649" width="600" height="24" as="geometry"/></mxCell><mxCell id="text-5" value="The host reaches only the DMA region and the MMIO pages;" style="text;html=1;verticalAlign=middle;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1180" y="434" width="600" height="24" as="geometry"/></mxCell><mxCell id="text-6" value="it loads programs into DDR through the processing system." style="text;html=1;verticalAlign=middle;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1180" y="454" width="600" height="24" as="geometry"/></mxCell><mxCell id="page-note" value="Addresses are as the CPU and the host see them. The host aperture is 128 KiB at 0xA400_0000 in the PS map." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1"><mxGeometry x="30" y="690" width="1740" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Reset, clock, interrupt" id="soc-reset-clock-interrupt"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Resets, clocks and interrupts" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1000" height="36" as="geometry"/></mxCell><mxCell id="group-0" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Clocks&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="560" height="300" as="geometry"/></mxCell><mxCell id="group-1" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Resets&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="620" y="70" width="560" height="300" as="geometry"/></mxCell><mxCell id="group-2" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;CPU stop lifecycle (cpu_stop_ctrl)&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1220" y="70" width="560" height="300" as="geometry"/></mxCell><mxCell id="group-3" value="&lt;span style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Interrupts to the CPU&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;opacity=50;verticalAlign=top;align=left;spacingTop=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="20" y="410" width="1760" height="300" as="geometry"/></mxCell><mxCell id="core" value="core_clk&lt;br&gt;CPU, caches, memory, AXI fabric, UART, timer, SoC CSRs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="520" height="70" as="geometry"/></mxCell><mxCell id="one" value="One clock domain&lt;br&gt;no internal clock crossings; 150 MHz on the KV260" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="520" height="70" as="geometry"/></mxCell><mxCell id="ext" value="External reset&lt;br&gt;active high, from the platform" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="640" y="110" width="520" height="60" as="geometry"/></mxCell><mxCell id="sync" value="Reset release&lt;br&gt;synchronized to core_clk in the block design;&lt;br&gt;the SoC uses it directly" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="640" y="190" width="520" height="60" as="geometry"/></mxCell><mxCell id="csr" value="SoC CSR reset value&lt;br&gt;requests CPU stop; with host-controlled boot the host&lt;br&gt;releases the CPU after loading memory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="640" y="270" width="520" height="80" as="geometry"/></mxCell><mxCell id="run" value="Running" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1240" y="110" width="160" height="70" as="geometry"/></mxCell><mxCell id="drain" value="Draining&lt;br&gt;pipeline in reset-hold&lt;br&gt;caches clocked" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1420" y="110" width="160" height="70" as="geometry"/></mxCell><mxCell id="held" value="Held&lt;br&gt;whole tile in reset-hold&lt;br&gt;status.stopped set" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1600" y="110" width="160" height="70" as="geometry"/></mxCell><mxCell id="wait" value="Drain conditions&lt;br&gt;router idle, both cache states and response slots idle,&lt;br&gt;line arbiter without an outstanding read, fence maintenance idle&lt;br&gt;memory, the fabric and the CSRs stay active throughout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1240" y="220" width="520" height="130" as="geometry"/></mxCell><mxCell id="timer" value="Machine timer&lt;br&gt;mtime compare gives the timer level;&lt;br&gt;msip gives the software level" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="330" height="90" as="geometry"/></mxCell><mxCell id="uart" value="UART&lt;br&gt;level interrupt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="400" y="460" width="330" height="90" as="geometry"/></mxCell><mxCell id="act" value="ACT external level&lt;br&gt;writable validation register" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="760" y="460" width="330" height="90" as="geometry"/></mxCell><mxCell id="cpu" value="CPU&lt;br&gt;external = UART or ACT&lt;br&gt;software reads the devices to tell which" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1480" y="460" width="270" height="90" as="geometry"/></mxCell><mxCell id="note" value="Interrupt handling&lt;br&gt;levels are not queued; the CPU takes them at commit when enabled in mie and mstatus, and an interrupt waits while&lt;br&gt;a store or atomic is authorized. The SoC ties return, trap, failure and completion status inputs to zero today;&lt;br&gt;the boot stub reports completion through two words in the DMA buffer." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="1710" height="90" as="geometry"/></mxCell><mxCell id="page-note" value="The KV260 build runs everything on one clock, core_clk." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1"><mxGeometry x="30" y="730" width="1740" height="24" as="geometry"/></mxCell><mxCell id="edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fillColor=#f5f5f5;strokeColor=#666666;" edge="1" parent="1" source="ext" target="sync"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fillColor=#fff2cc;strokeColor=#d6b656;" edge="1" parent="1" source="sync" target="csr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-2" value="stop request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#d5e8d4;strokeColor=#82b366;" edge="1" parent="1" source="run" target="drain"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-3" value="idle" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#ffe6cc;strokeColor=#d79b00;" edge="1" parent="1" source="drain" target="held"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fillColor=#ffe6cc;strokeColor=#d79b00;" edge="1" parent="1" source="drain" target="wait"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1500" y="200"/></Array></mxGeometry></mxCell><mxCell id="edge-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=0.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fillColor=#e1d5e7;strokeColor=#9673a6;" edge="1" parent="1" source="timer" target="cpu"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="205" y="440"/><mxPoint x="1615" y="440"/></Array></mxGeometry></mxCell><mxCell id="edge-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=0.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;fillColor=#e1d5e7;strokeColor=#9673a6;" edge="1" parent="1" source="uart" target="cpu"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="565" y="445"/><mxPoint x="1615" y="445"/></Array></mxGeometry></mxCell><mxCell id="edge-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#f5f5f5;strokeColor=#666666;" edge="1" parent="1" source="act" target="cpu"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>