# orca kernel: minimal defconfig, expanded by olddefconfig.
# started from buildroot board/qemu/riscv32-virt/linux-nommu.config.
# CONFIG_MMU is not set
CONFIG_NONPORTABLE=y
CONFIG_ARCH_RV32I=y
# CONFIG_RISCV_ISA_C is not set
# CONFIG_FPU is not set
# CONFIG_RISCV_ISA_V is not set
# CONFIG_SMP is not set
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_BINFMT_FLAT=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_CLINT_TIMER=y
# the plic driver is only for the qemu cross-check; orca's tree has no plic
CONFIG_SIFIVE_PLIC=y
CONFIG_PRINTK_TIME=y
# uncompressed initramfs: gzip inflate dominates early boot time in simulation
CONFIG_INITRAMFS_COMPRESSION_NONE=y
# orca has none of these; keep them out so no code path relies on runtime patching
# CONFIG_RISCV_ISA_ZACAS is not set
# CONFIG_RISCV_ISA_ZABHA is not set
# CONFIG_RISCV_ISA_ZAWRS is not set
# CONFIG_RISCV_ISA_ZBA is not set
# CONFIG_RISCV_ISA_ZBB is not set
# CONFIG_RISCV_ISA_ZBC is not set
# CONFIG_RISCV_ISA_ZBKB is not set
# CONFIG_RISCV_ISA_ZICBOM is not set
# CONFIG_RISCV_ISA_ZICBOZ is not set
# buildroot sets INITRAMFS_SOURCE after this file is merged, so the compression
# choice above is not visible yet; with no decompressors "none" is its only option
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
